# Required for PostgreSQL-backed API routes.
# Export manually; the backend does not automatically load this file.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# Comma-separated browser origins. Set this to the frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
